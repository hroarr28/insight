# Demo is the default, even when OPENAI_API_KEY is set.
# Live mode starts only when APP_MODE=live.
# APP_MODE=demo

# Live local answers. Set both. No paid API.
# APP_MODE=live
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=gemma4:31b
# OLLAMA_EMBED_MODEL=embeddinggemma

# Paid provider. Opt in. Leave unset on the public demo.
# OPENAI_API_KEY=

# Supabase is not used in demo mode. Required only for live mode.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Delete is refused unless this is set to at least 16 characters.
# Send it as: Authorization: Bearer <secret>
# ADMIN_SECRET=

# On Vercel production the daily OpenAI call cap is on unless DEMO_MODE=false.
# DEMO_MODE=true
# DEMO_DAILY_MODEL_CALLS=40

# Database seed calls the paid embeddings API only when this is true.
# SEED_WITH_OPENAI=false
