# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (for embeddings + chat)
OPENAI_API_KEY=your-openai-key

# Retrieval. Default is hybrid (vector + full text, fused with RRF).
# vector skips full text. hybrid-rerank asks for the optional reranker.
# RETRIEVAL_MODE=hybrid

# Optional rerank with gpt-4o-mini. Off unless this is exactly true.
# If the key is missing or the model call fails, results stay in fused order.
# RERANK_ENABLED=false
