# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (for embeddings + chat)
OPENAI_API_KEY=your-openai-key

# Retrieval. Default is hybrid (vector + full text, fused with RRF).
# vector skips full text. hybrid-rerank asks for the optional reranker.
# RETRIEVAL_MODE=hybrid

# Optional rerank with the selected chat model. Off unless this is exactly true.
# If the model call fails, results stay in fused order.
# RERANK_ENABLED=false

# Model provider. Unset or openai keeps the deployed path (gpt-4o-mini,
# text-embedding-3-small, vector(1536)). ollama is for a machine running Ollama.
# The database column is 1536-wide, so ollama embeddings are refused by upload
# and search. Use npm run eval:local for measurements. It does not use Supabase.
# LLM_PROVIDER=openai
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=gemma4:31b
# OLLAMA_EMBED_MODEL=embeddinggemma
# OLLAMA_EMBED_DIMENSIONS=768
